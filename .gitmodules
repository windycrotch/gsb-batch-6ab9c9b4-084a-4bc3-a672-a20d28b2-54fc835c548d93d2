[submodule "lib/SDL"]
	path = lib/SDL
	url = https://github.com/libsdl-org/SDL
	branch = SDL2
[submodule "lib/flac"]
	path = lib/flac
	url = https://github.com/xiph/flac
[submodule "lib/minimp3"]
	path = lib/minimp3
	url = https://github.com/lieff/minimp3
[submodule "lib/opusfile"]
	path = lib/opusfile
	url = https://github.com/xiph/opusfile
[submodule "lib/opus"]
	path = lib/opus
	url = https://github.com/xiph/opus
[submodule "lib/ogg"]
	path = lib/ogg
	url = https://github.com/xiph/ogg
